{
  "name": "@findai/slp",
  "version": "0.1.1",
  "description": "Static analysis for JS/TS: dead exports, duplicates, empty wrappers (incl. JSX), useless type predicates, same-shape types, useless async, empty catch, plus cross-detector insights. Zero config, safe --fix.",
  "type": "module",
  "bin": {
    "slp": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/cli.js",
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "format": "biome format --write src",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dead-code",
    "duplicate-code",
    "unused-exports",
    "static-analysis",
    "code-quality",
    "linter",
    "ts-prune",
    "knip",
    "jscpd",
    "typescript",
    "ai",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeepUni/slp.git"
  },
  "homepage": "https://github.com/KeepUni/slp#readme",
  "bugs": {
    "url": "https://github.com/KeepUni/slp/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "ignore": "^7.0.5",
    "picocolors": "^1.1.1",
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
